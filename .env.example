HISN_MODE=DEMO
HISN_PORT=4310
HISN_DATABASE_PATH=./var/hisn-ot.db
HISN_POLICY_PATH=./config/policy.v1.json
HISN_SCENARIO_PATH=./config/scenarios.v1.json
HISN_LOG_LEVEL=info
# HISN_SESSION_SECRET=generate-at-least-32-random-characters

# Enable authenticated Nokia test-network calls while keeping physical operations simulated.
# HISN_NOKIA_SIMULATOR=true
# NOKIA_NAC_BASE_URL=https://network-as-code.p-eu.rapidapi.com
# NOKIA_NAC_API_KEY=
# NOKIA_NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
# Optional: required only for Number Verification V1 subscriber authorization.
# NOKIA_NAC_ACCESS_TOKEN=
# HISN_OPERATOR_PHONE=+99999991001
# HISN_BACKUP_PHONE=+99999991001
# HISN_APP_SERVER_IPV4=233.252.0.2
# HISN_GEOFENCE_LATITUDE=29.5267
# HISN_GEOFENCE_LONGITUDE=35.0078
# HISN_GEOFENCE_RADIUS_METERS=500
# Optional pair: only configure after creating and activating a real simulator slice attachment.
# HISN_GATEWAY_NAI=
# HISN_BACKUP_IPV4=
# HISN_OPERATIONAL_SLICE_ID=

# Optional zero-cost hosted reasoner. Create a free Groq key and keep it server-side.
# HISN_LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# HISN_LLM_API_KEY=
# HISN_LLM_MODEL=openai/gpt-oss-20b
