# Safe local defaults. Copy this file to .env.local, then run: npm run doctor
HISN_MODE=DEMO
HISN_PORT=4310
HISN_DATABASE_PATH=./var/hisn-ot.db
HISN_POLICY_PATH=./config/policy.v1.json
HISN_SCENARIO_PATH=./config/scenarios.v1.json
HISN_REHEARSAL_RATE_LIMIT_MAX=12
HISN_LOG_LEVEL=info
HISN_SESSION_SECRET=replace_with_at_least_32_random_characters

# AUTO uses Groq when all three model values are configured. Without them, a local
# run uses the explicitly labeled deterministic replay. Hosted failures stay fail-closed.
HISN_AGENT_PROVIDER=AUTO
# HISN_LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# HISN_LLM_API_KEY=replace_with_rotated_groq_key
# HISN_LLM_MODEL=openai/gpt-oss-20b

# Nokia test network. Replace the key, then set HISN_NOKIA_SIMULATOR=true.
HISN_NOKIA_SIMULATOR=false
NOKIA_NAC_BASE_URL=https://network-as-code.p-eu.rapidapi.com
NOKIA_NAC_API_KEY=replace_with_rotated_nokia_key
NOKIA_NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
HISN_OPERATOR_PHONE=+99999991000
HISN_BACKUP_PHONE=+99999991001
HISN_APP_SERVER_IPV4=233.252.0.2
HISN_GEOFENCE_LATITUDE=29.5267
HISN_GEOFENCE_LONGITUDE=35.0078
HISN_GEOFENCE_RADIUS_METERS=500

# Optional bearer from a real subscriber OAuth flow. Strict sandbox verification
# obtains a one-time Nokia simulator fast-flow code instead.
# NOKIA_NAC_ACCESS_TOKEN=replace_with_subscriber_access_token

# Optional pair for a real simulator slice attachment.
# HISN_GATEWAY_NAI=replace_with_network_access_identifier
# HISN_OPERATIONAL_SLICE_ID=replace_with_slice_id
# HISN_BACKUP_IPV4=198.51.100.20
